# Everything is optional. With no keys, ADGENT runs end to end on a built-in PayPal
# simulator and an offline shopping agent, and every screen says so.

# ── PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ──
# REST app owned by the ADGENT platform business account (the "PayPal Ads" side).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Same client id, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook id from the dashboard (Webhooks → <APP_URL>/api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
# Platform account merchant id, and BN code if PayPal enabled you as a partner (platform_fees mode only)
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=

# How ADGENT gets paid:
#   payouts       → ADGENT receives the sale; after the refund hold, PayPal Payouts pays the merchant its net and the publisher its share (default)
#   platform_fees → merchant receives the sale; PayPal splits the ad fee at capture (needs a Multiparty-enabled partner app)
#   invoice       → merchant receives the sale; ad fees are billed afterwards with the PayPal Invoicing API
ADGENT_FEE_MODE=payouts
# Refund window before payouts go out (seconds). 120 keeps demos snappy.
SETTLEMENT_HOLD_SECONDS=120

# Sandbox accounts that receive payouts (optional; placeholders are used otherwise)
DEMO_MERCHANT_PAYPAL_EMAIL=
DEMO_MERCHANT_PAYPAL_ID=
DEMO_PUBLISHER_PAYPAL_EMAIL=

# ── Claude ──
ANTHROPIC_API_KEY=
# Campaign strategy + shopping agent
ADGENT_MODEL=claude-opus-5-5
# Offer ranking + "ask your ads"
ADGENT_MODEL_FAST=claude-haiku-5-5

# ── App ──
DATABASE_URL=file:./adgent.db
# Turso/libsql auth token when DATABASE_URL is remote
DATABASE_AUTH_TOKEN=
# Public URL of this deployment (used for PayPal return/cancel links)
APP_URL=http://localhost:3000
# Required for payouts/refunds/invoices once real PayPal keys are set (24+ random characters)
ADMIN_TOKEN=
# Set to 1 on serverless hosts; then call POST /api/cron on a schedule instead
ADGENT_DISABLE_WORKER=
