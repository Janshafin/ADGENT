# ── PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ──
# REST app owned by the ADGENT platform account (the "PayPal Ads" side).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Platform account merchant id (Sandbox → Accounts → business account → Merchant ID)
PAYPAL_PLATFORM_MERCHANT_ID=
# BN code if your app is a registered partner (optional; required for platform_fees)
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Webhook id from the dashboard (Webhooks → your URL/api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=

# How the ad fee is collected:
#   platform_fees → split automatically at capture (needs Multiparty-enabled partner app)
#   invoice       → fees accrue in the ledger, merchant is billed via the Invoicing API
ADGENT_FEE_MODE=invoice

# Demo merchant payee (sandbox business account that receives sales)
DEMO_MERCHANT_PAYPAL_EMAIL=
DEMO_MERCHANT_PAYPAL_ID=

# Exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ── Claude ──
ANTHROPIC_API_KEY=
ADGENT_MODEL=claude-opus-5-5

# ── App ──
DATABASE_URL=file:./adgent.db
# Turso/libsql auth token when DATABASE_URL is remote (optional)
DATABASE_AUTH_TOKEN=
APP_URL=http://localhost:3000
DEMO_PUBLISHER_PAYPAL_EMAIL=
